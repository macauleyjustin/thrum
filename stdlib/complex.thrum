# Complex arithmetic and radix-2 Cooley-Tukey Fast Fourier Transform in pure Thrum.

use math

# Complex number z = re + im*i.
record Complex:
    re: num
    im: num = 0

# Construct Complex(re, im).
fn make(re: num, im: num = 0) -> Complex:
    return Complex(re, im)

# Construct Complex from polar coordinates r * exp(i * theta).
fn polar(r: num, theta: 1) -> Complex:
    return Complex(r * math.cos(theta), r * math.sin(theta))

# Complex addition a + b.
fn cadd(a: Complex, b: Complex) -> Complex:
    return Complex(a.re + b.re, a.im + b.im)

# Complex subtraction a - b.
fn csub(a: Complex, b: Complex) -> Complex:
    return Complex(a.re - b.re, a.im - b.im)

# Complex multiplication a * b.
fn cmul(a: Complex, b: Complex) -> Complex:
    return Complex(a.re * b.re - a.im * b.im, a.re * b.im + a.im * b.re)

# Complex division a / b.
fn cdiv(a: Complex, b: Complex) -> Complex:
    let den = b.re * b.re + b.im * b.im
    if bare(den) == 0:
        fail "complex division by zero"
    return Complex((a.re * b.re + a.im * b.im) / den, (a.im * b.re - a.re * b.im) / den)

# Complex conjugate a*.
fn conj(a: Complex) -> Complex:
    return Complex(a.re, -a.im)

# Complex magnitude |a|.
fn cmag(a: Complex) -> num:
    return math.hypot(a.re, a.im)

# Complex phase angle arg(a) in radians.
fn carg(a: Complex) -> 1:
    return math.atan2(a.im, a.re)

# Complex exponential exp(z) = exp(re) * (cos(im) + i sin(im)).
fn cexp(a: Complex) -> Complex:
    let er = math.exp(a.re)
    return Complex(er * math.cos(a.im), er * math.sin(a.im))

fn _fft_core(xs: list[Complex], inverse: bool) -> list[Complex]:
    let n = len(xs)
    if n <= 1:
        return xs
    if math.band(n, n - 1) != 0:
        fail "fft input length must be a power of 2"
    var even = []
    var odd = []
    for i in 0..<n:
        if i % 2 == 0:
            even = push(even, xs[i])
        else:
            odd = push(odd, xs[i])
    let fe = _fft_core(even, inverse)
    let fo = _fft_core(odd, inverse)
    var out = [Complex(0, 0) for _ in 0..<n]
    let half = floor(n / 2)
    var dir = -1
    if inverse:
        dir = 1
    for k in 0..<half:
        let ang = dir * math.tau * k / n
        let w = Complex(math.cos(ang), math.sin(ang))
        let t = cmul(w, fo[k])
        out[k] = cadd(fe[k], t)
        out[k + half] = csub(fe[k], t)
    return out

# Radix-2 Fast Fourier Transform (input length must be a power of 2).
fn fft(xs: list[Complex]) -> list[Complex]:
    return _fft_core(xs, false)

# Inverse radix-2 Fast Fourier Transform scaled by 1/N.
fn ifft(xs: list[Complex]) -> list[Complex]:
    let n = len(xs)
    if n == 0:
        return []
    let raw = _fft_core(xs, true)
    return [Complex(z.re / n, z.im / n) for z in raw]
