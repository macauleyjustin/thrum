# Dimension-preserving 2D and 3D vector records and operations.

# 2D vector with numeric coordinates (any shared or distinct units).
record Vec2:
    x: num
    y: num

# 3D vector with numeric coordinates.
record Vec3:
    x: num
    y: num
    z: num

# Construct a 2D vector.
fn vec2(x: num, y: num) -> Vec2:
    return Vec2{x: x, y: y}

# Construct a 3D vector.
fn vec3(x: num, y: num, z: num) -> Vec3:
    return Vec3{x: x, y: y, z: z}

# Add two 2D vectors.
fn add2(a: Vec2, b: Vec2) -> Vec2:
    return Vec2{x: a.x + b.x, y: a.y + b.y}

# Subtract two 2D vectors (a - b).
fn sub2(a: Vec2, b: Vec2) -> Vec2:
    return Vec2{x: a.x - b.x, y: a.y - b.y}

# Scale a 2D vector by scalar s.
fn scale2(v: Vec2, s: num) -> Vec2:
    return Vec2{x: v.x * s, y: v.y * s}

# Dot product of two 2D vectors.
fn dot2(a: Vec2, b: Vec2) -> num:
    return a.x * b.x + a.y * b.y

# Euclidean magnitude of a 2D vector.
fn mag2(v: Vec2) -> num:
    return sqrt(v.x^2 + v.y^2)

# Unit direction vector of a non-zero 2D vector.
fn norm2(v: Vec2) -> Vec2:
    requires bare(mag2(v)) > 0, "cannot normalize zero vector"
    let m = mag2(v)
    return Vec2{x: v.x / m, y: v.y / m}

# Euclidean distance between two 2D points.
fn dist2(a: Vec2, b: Vec2) -> num:
    return mag2(sub2(a, b))

# Add two 3D vectors.
fn add3(a: Vec3, b: Vec3) -> Vec3:
    return Vec3{x: a.x + b.x, y: a.y + b.y, z: a.z + b.z}

# Subtract two 3D vectors (a - b).
fn sub3(a: Vec3, b: Vec3) -> Vec3:
    return Vec3{x: a.x - b.x, y: a.y - b.y, z: a.z - b.z}

# Scale a 3D vector by scalar s.
fn scale3(v: Vec3, s: num) -> Vec3:
    return Vec3{x: v.x * s, y: v.y * s, z: v.z * s}

# Dot product of two 3D vectors.
fn dot3(a: Vec3, b: Vec3) -> num:
    return a.x * b.x + a.y * b.y + a.z * b.z

# Cross product of two 3D vectors.
fn cross3(a: Vec3, b: Vec3) -> Vec3:
    return Vec3{
        x: a.y * b.z - a.z * b.y,
        y: a.z * b.x - a.x * b.z,
        z: a.x * b.y - a.y * b.x,
    }

# Euclidean magnitude of a 3D vector.
fn mag3(v: Vec3) -> num:
    return sqrt(v.x^2 + v.y^2 + v.z^2)

# Unit direction vector of a non-zero 3D vector.
fn norm3(v: Vec3) -> Vec3:
    requires bare(mag3(v)) > 0, "cannot normalize zero vector"
    let m = mag3(v)
    return Vec3{x: v.x / m, y: v.y / m, z: v.z / m}

# Euclidean distance between two 3D points.
fn dist3(a: Vec3, b: Vec3) -> num:
    return mag3(sub3(a, b))
