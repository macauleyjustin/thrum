# URL parser, relative resolver, and address-bar normalization for Thrum Browser.

use text
use "./buf.thrum" as b

fn url_encode_query(s) -> text:
    let chars = list(s)
    var out = b.buf_new()
    for ch in chars:
        if ch == " ":
            out = b.buf_push(out, "+")
        elif ch == "&":
            out = b.buf_push(out, "%26")
        elif ch == "=":
            out = b.buf_push(out, "%3D")
        elif ch == "+":
            out = b.buf_push(out, "%2B")
        elif ch == "#":
            out = b.buf_push(out, "%23")
        elif ch == "?":
            out = b.buf_push(out, "%3F")
        elif ch == "/":
            out = b.buf_push(out, "%2F")
        else:
            out = b.buf_push(out, ch)
    return b.buf_join(out)

fn parse_url(u):
    if starts(u, "about:"):
        return {scheme: "about", host: "", path: slice(u, 6), fragment: "", query: ""}
    if starts(u, "file://"):
        return {scheme: "file", host: "", path: slice(u, 7), fragment: "", query: ""}
    var scheme = "https"
    var rest = u
    if starts(u, "https://"):
        scheme = "https"
        rest = slice(u, 8)
    elif starts(u, "http://"):
        scheme = "http"
        rest = slice(u, 7)
    var frag = ""
    let fi = text.index_of(rest, "#")
    if fi >= 0:
        frag = slice(rest, fi + 1)
        rest = slice(rest, 0, fi)
    var query = ""
    let qi = text.index_of(rest, "?")
    if qi >= 0:
        query = slice(rest, qi + 1)
        rest = slice(rest, 0, qi)
    var host = rest
    var p = "/"
    let si = text.index_of(rest, "/")
    if si >= 0:
        host = slice(rest, 0, si)
        p = slice(rest, si)
    return {scheme: scheme, host: host, path: p, fragment: frag, query: query}

fn norm_dot_segments(p) -> text:
    let parts = split(p, "/")
    var stack = []
    for seg in parts:
        if seg == "" or seg == ".":
            continue
        elif seg == "..":
            if len(stack) > 0:
                stack = pop(stack)
        else:
            stack = push(stack, seg)
    return "/" + join("/", stack)

fn resolve_url(base_url, href) -> text:
    let h = trim(href)
    if h == "":
        return base_url
    if starts(h, "about:") or starts(h, "http://") or starts(h, "https://") or starts(h, "file://"):
        return h
    if starts(lower(h), "javascript:") or starts(lower(h), "mailto:") or starts(lower(h), "data:"):
        return ""
    let bu = parse_url(base_url)
    if starts(h, "//"):
        if bu.scheme == "http":
            return "http:" + h
        return "https:" + h
    if starts(h, "#"):
        var base_no_frag = base_url
        let fpos = text.index_of(base_no_frag, "#")
        if fpos >= 0:
            base_no_frag = slice(base_no_frag, 0, fpos)
        return base_no_frag + h
    if bu.scheme == "about":
        return h
    if bu.scheme == "file":
        if starts(h, "/"):
            return "file://" + h
        let bdir = slice(bu.path, 0, max([0, text.index_of(bu.path, "/")]))
        return "file://" + h
    if starts(h, "?"):
        return bu.scheme + "://" + bu.host + bu.path + h
    if starts(h, "/"):
        return bu.scheme + "://" + bu.host + h
    # Relative path against current directory of bu.path
    var dir = "/"
    let slash_parts = split(bu.path, "/")
    if len(slash_parts) > 1:
        var kept = slash_parts[:len(slash_parts) - 1]
        dir = join("/", kept) + "/"
    var rel = h
    var tail_q = ""
    let fi = text.index_of(rel, "#")
    if fi >= 0:
        tail_q = slice(rel, fi)
        rel = slice(rel, 0, fi)
    let qi = text.index_of(rel, "?")
    if qi >= 0:
        tail_q = slice(rel, qi) + tail_q
        rel = slice(rel, 0, qi)
    return bu.scheme + "://" + bu.host + norm_dot_segments(dir + rel) + tail_q

fn normalize_input(raw) -> text:
    let s = trim(raw)
    if s == "":
        return "about:home"
    if starts(s, "about:") or starts(s, "http://") or starts(s, "https://") or starts(s, "file://"):
        return s
    if starts(s, "/"):
        return "file://" + s
    if not (" " in s) and (("." in s) or starts(s, "localhost")):
        if starts(s, "localhost") or starts(s, "127.0.0.1"):
            return "http://" + s
        return "https://" + s
    return "https://lite.duckduckgo.com/lite/?q=" + url_encode_query(s)
