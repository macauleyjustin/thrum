# Thrum Web Browser — Native macOS GUI + HTTPS Browser written in Thrum
# Compile standalone:  ./thrumc build examples/browser.thrum -o browser
# Launch interactive:  ./browser
# Headless snapshot:   THRUM_GUI_HEADLESS=1 ./browser --url https://example.com --screenshot out.png

use text
use "./browser/url.thrum" as bu
use "./browser/html.thrum" as bh
use "./browser/layout.thrum" as bl
use "./browser/pages.thrum" as bp

# Live reactive document & viewport state
var active_tab_idx = 0
var doc_words = 0
var doc_links = 0
var doc_nodes = 0
var scroll_y = 0
var doc_total_h = 600
var view_h = 600
var status_text = "Ready"

let max_scroll = max([0, doc_total_h - view_h])
let scroll_pct = round(scroll_y / max([1, max_scroll]) * 100)

fn point_in(px, py, rx, ry, rw, rh) -> bool:
    return px >= rx and px <= rx + rw and py >= ry and py <= ry + rh

fn run_browser_app(gui, net, clock, fs, args, io):
    pin argv = args.all()
    var init_url = "about:home"
    var shot_path = nil

    for i in 0..<len(argv):
        if argv[i] == "--url" and i + 1 < len(argv):
            init_url = argv[i + 1]
        elif argv[i] == "--screenshot" and i + 1 < len(argv):
            shot_path = argv[i + 1]

    var dark_mode = false
    var show_source = false
    var url_focused = false
    var url_input = init_url
    var hover_x = -1
    var hover_y = -1
    var hover_href = ""
    var dragging_scroll = false
    var drag_sb_off = 0

    # Tab list: each tab stores {url, title, raw_body, headers, status, load_ms, parsed, layout, scroll_y, history, fwd}
    var tabs = []
    var last_layout_w = 0

    fn measure_cb(txt, sz, bold, mono):
        return gui.measure(txt, sz, bold, mono)

    fn chrome_palette():
        if dark_mode:
            return {
                bar: [26, 30, 36],
                tab_active: [38, 44, 52],
                tab_idle: [20, 24, 29],
                input_bg: [16, 19, 24],
                input_bd: [66, 76, 88],
                focus_bd: [74, 158, 255],
                btn_bg: [40, 46, 56],
                btn_hov: [56, 65, 78],
                txt: [232, 236, 242],
                muted: [148, 158, 172],
                accent: [52, 211, 153],
                border: [48, 54, 64],
                sb_track: [24, 28, 34],
                sb_thumb: [84, 94, 108],
            }
        return {
            bar: [236, 240, 244],
            tab_active: [252, 252, 253],
            tab_idle: [222, 227, 233],
            input_bg: [255, 255, 255],
            input_bd: [200, 206, 214],
            focus_bd: [24, 114, 232],
            btn_bg: [246, 248, 250],
            btn_hov: [228, 234, 240],
            txt: [28, 32, 38],
            muted: [100, 110, 124],
            accent: [16, 128, 78],
            border: [208, 214, 222],
            sb_track: [240, 242, 246],
            sb_thumb: [176, 184, 196],
        }

    fn sync_reactive_from_tab():
        let t = tabs[active_tab_idx]
        doc_words = t.parsed.stats.words
        doc_links = t.parsed.stats.links
        doc_nodes = t.parsed.stats.nodes
        doc_total_h = t.layout.total_h
        scroll_y = t.scroll_y

    fn fetch_and_parse(raw_u):
        let norm_u = bu.normalize_input(raw_u)
        let t0 = clock.mono()
        var final_url = norm_u
        var status = 200
        var hdrs = {}
        var body = ""
        var ctype = "text/html"
        var err = ""

        if starts(norm_u, "about:"):
            body = bp.about_page(norm_u)
        elif starts(norm_u, "file://"):
            let fpath = slice(norm_u, 7)
            var rel = fpath
            if starts(rel, "/"):
                # Sandbox safety cleanly checks file existence
                if fs.is_file(rel):
                    body = fs.read(rel)
                else:
                    err = "File not found in workspace: " + rel
                    status = 404
            else:
                if fs.is_file(rel):
                    body = fs.read(rel)
                else:
                    err = "File not found: " + rel
                    status = 404
            if err != "":
                body = bp.error_page(norm_u, status, err)
            elif not ends(lower(rel), ".html") and not ends(lower(rel), ".htm"):
                body = bp.text_to_html(rel, body)
        else:
            let resp = net.get(norm_u)
            status = resp.status
            final_url = resp.url
            if final_url == "":
                final_url = norm_u
            hdrs = resp.headers
            ctype = lower(resp.content_type)
            err = resp.error
            if not resp.ok and resp.body == "":
                body = bp.error_page(norm_u, status, err)
            elif not ("html" in ctype) and not ("<html" in lower(slice(resp.body, 0, min([256, len(resp.body)])))) and not ("<!doctype" in lower(slice(resp.body, 0, min([256, len(resp.body)])))):
                body = bp.text_to_html(final_url, resp.body)
            else:
                body = resp.body

        let ms = round(bare(clock.mono() - t0) * 1000)
        let parsed = bh.parse_html(body)
        var ttl = parsed.title
        if ttl == "":
            let pu = bu.parse_url(final_url)
            if pu.host != "":
                ttl = pu.host
            else:
                ttl = final_url
        return {
            url: final_url,
            title: ttl,
            raw_body: body,
            headers: hdrs,
            status: status,
            load_ms: ms,
            parsed: parsed,
            error: err,
        }

    fn relayout_tab(idx, win_w):
        var t = tabs[idx]
        var page_w = win_w
        if show_source:
            page_w = max([340, win_w - 360])
        let lay = bl.layout_document(t.parsed.doc, page_w, dark_mode, measure_cb, t.url, bu.resolve_url)
        t["layout"] = lay
        tabs[idx] = t
        if idx == active_tab_idx:
            sync_reactive_from_tab()

    fn relayout_all(win_w):
        last_layout_w = win_w
        for idx in 0..<len(tabs):
            relayout_tab(idx, win_w)

    fn navigate_tab(idx, target_url, record_history = true):
        let sz = gui.size()
        let cur = tabs[idx]
        var hist = cur.history
        var fwd = cur.fwd
        if record_history and cur.url != "" and cur.url != target_url:
            hist = push(hist, cur.url)
            fwd = []
        status_text = "Loading {target_url}..."
        let res = fetch_and_parse(target_url)
        var page_w = sz.width
        if show_source:
            page_w = max([340, sz.width - 360])
        let lay = bl.layout_document(res.parsed.doc, page_w, dark_mode, measure_cb, res.url, bu.resolve_url)
        tabs[idx] = {
            url: res.url,
            title: res.title,
            raw_body: res.raw_body,
            headers: res.headers,
            status: res.status,
            load_ms: res.load_ms,
            parsed: res.parsed,
            layout: lay,
            scroll_y: 0,
            history: hist,
            fwd: fwd,
            error: res.error,
        }
        if idx == active_tab_idx:
            url_input = res.url
            url_focused = false
            sync_reactive_from_tab()
            status_text = "HTTP {res.status}  •  {res.load_ms} ms  •  {res.parsed.stats.links} links  •  {res.parsed.stats.words} words"

    fn open_new_tab(target_url):
        let sz = gui.size()
        let placeholder = {
            url: "", title: "Loading...", raw_body: "", headers: {}, status: 0, load_ms: 0,
            parsed: bh.parse_html("<p>Loading...</p>"), layout: {boxes: [], links: [], total_h: 100, content_w: 600, start_x: 20},
            scroll_y: 0, history: [], fwd: [], error: "",
        }
        tabs = push(tabs, placeholder)
        active_tab_idx = len(tabs) - 1
        navigate_tab(active_tab_idx, target_url, false)

    fn go_back():
        var t = tabs[active_tab_idx]
        if len(t.history) == 0:
            return
        let prev = t.history[len(t.history) - 1]
        t["history"] = pop(t.history)
        t["fwd"] = push(t.fwd, t.url)
        tabs[active_tab_idx] = t
        navigate_tab(active_tab_idx, prev, false)

    fn go_forward():
        var t = tabs[active_tab_idx]
        if len(t.fwd) == 0:
            return
        let nxt = t.fwd[len(t.fwd) - 1]
        t["fwd"] = pop(t.fwd)
        t["history"] = push(t.history, t.url)
        tabs[active_tab_idx] = t
        navigate_tab(active_tab_idx, nxt, false)

    fn set_scroll(ny):
        var t = tabs[active_tab_idx]
        let ms = max([0, t.layout.total_h - view_h])
        let clamped = clamp(ny, 0, ms)
        t["scroll_y"] = clamped
        tabs[active_tab_idx] = t
        scroll_y = clamped

    fn compute_chrome(win_w, win_h):
        let tab_h = 34
        let nav_h = 44
        let bm_h = 28
        let top_h = tab_h + nav_h + bm_h
        let bot_h = 26
        let vh = max([120, win_h - top_h - bot_h])
        var page_w = win_w
        if show_source:
            page_w = max([340, win_w - 360])

        let back_btn = {x: 10, y: tab_h + 7, w: 30, h: 30, label: "←"}
        let fwd_btn = {x: 44, y: tab_h + 7, w: 30, h: 30, label: "→"}
        let rel_btn = {x: 78, y: tab_h + 7, w: 30, h: 30, label: "↻"}
        let home_btn = {x: 112, y: tab_h + 7, w: 30, h: 30, label: "⌂"}
        let src_btn = {x: win_w - 78, y: tab_h + 7, w: 68, h: 30, label: "Source"}
        let thm_btn = {x: win_w - 134, y: tab_h + 7, w: 50, h: 30, label: "Theme"}
        let url_bar = {x: 150, y: tab_h + 7, w: max([160, win_w - 294]), h: 30}

        let bms = [
            {label: "Start", url: "about:home"},
            {label: "Thrum Page", url: "about:thrum"},
            {label: "Example", url: "https://example.com"},
            {label: "Hacker News", url: "https://news.ycombinator.com"},
            {label: "NPR Text", url: "https://text.npr.org"},
            {label: "DDG Lite", url: "https://lite.duckduckgo.com/lite/"},
            {label: "Wiki", url: "https://en.wikipedia.org/wiki/Compiler"},
            {label: "GitHub", url: "https://github.com/macauleyjustin/thrum"},
        ]
        var bm_btns = []
        var bx = 12
        for bm in bms:
            let mw = measure_cb(bm.label, 11.5, false, false).width + 18
            if bx + mw < win_w - 12:
                bm_btns = push(bm_btns, {x: bx, y: tab_h + nav_h + 3, w: mw, h: 22, label: bm.label, url: bm.url})
                bx += mw + 6

        return {
            win_w: win_w, win_h: win_h,
            tab_h: tab_h, nav_h: nav_h, bm_h: bm_h,
            top_h: top_h, bot_h: bot_h, view_h: vh, page_w: page_w,
            back_btn: back_btn, fwd_btn: fwd_btn, rel_btn: rel_btn, home_btn: home_btn,
            src_btn: src_btn, thm_btn: thm_btn, url_bar: url_bar, bm_btns: bm_btns,
        }

    fn draw_chrome_btn(c, pal, enabled = true, active = false):
        var bg = pal.btn_bg
        if active:
            bg = pal.focus_bd
        elif enabled and point_in(hover_x, hover_y, c.x, c.y, c.w, c.h):
            bg = pal.btn_hov
        gui.round_rect(c.x, c.y, c.w, c.h, 7, bg[0], bg[1], bg[2], 255)
        gui.stroke_rect(c.x, c.y, c.w, c.h, 7, 1.0, pal.border[0], pal.border[1], pal.border[2], 255)
        var tc = pal.txt
        if not enabled:
            tc = pal.muted
        elif active:
            tc = [255, 255, 255]
        gui.text(c.x + c.w / 2, c.y + c.h / 2, c.label, 13, tc[0], tc[1], tc[2], "mid", true)

    fn render(chr):
        let cp = chrome_palette()
        let pg_pal = bl.palette_for(dark_mode)
        let t = tabs[active_tab_idx]
        let lay = t.layout
        let sy = t.scroll_y
        let w = chr.win_w
        let h = chr.win_h

        gui.begin()
        gui.clear(pg_pal.bg[0], pg_pal.bg[1], pg_pal.bg[2])

        # 1. Clipped Web Page Viewport (y = top_h .. top_h + view_h)
        gui.clip(0, chr.top_h, chr.page_w, chr.view_h)
        let v_top = -36
        let v_bot = chr.view_h + 36
        for bx in lay.boxes:
            let bk = bx.kind
            if bk == "text":
                let dy = bx.y - sy + chr.top_h
                let ry_rel = bx.y - sy
                if ry_rel > v_bot or ry_rel + bx.sz * 1.6 < v_top:
                    continue
                gui.text(bx.x, dy, bx.txt, bx.sz, bx.col[0], bx.col[1], bx.col[2], bx.align, bx.bold, bx.a, bx.mono)
            elif bk == "line":
                let dy1 = bx.y1 - sy + chr.top_h
                let dy2 = bx.y2 - sy + chr.top_h
                if max([bx.y1, bx.y2]) - sy < v_top or min([bx.y1, bx.y2]) - sy > v_bot:
                    continue
                gui.line(bx.x1, dy1, bx.x2, dy2, bx.lw, bx.col[0], bx.col[1], bx.col[2], bx.a)
            elif bk == "rect":
                let dy = bx.y - sy + chr.top_h
                if bx.y - sy > v_bot or bx.y - sy + bx.h < v_top:
                    continue
                gui.rect(bx.x, dy, bx.w, bx.h, bx.col[0], bx.col[1], bx.col[2], bx.a)
            elif bk == "round":
                let dy = bx.y - sy + chr.top_h
                if bx.y - sy > v_bot or bx.y - sy + bx.h < v_top:
                    continue
                gui.round_rect(bx.x, dy, bx.w, bx.h, bx.rad, bx.col[0], bx.col[1], bx.col[2], bx.a)
            elif bk == "stroke":
                let dy = bx.y - sy + chr.top_h
                if bx.y - sy > v_bot or bx.y - sy + bx.h < v_top:
                    continue
                gui.stroke_rect(bx.x, dy, bx.w, bx.h, bx.rad, bx.lw, bx.col[0], bx.col[1], bx.col[2], bx.a)

        # Scrollbar inside right edge of viewport
        if lay.total_h > chr.view_h:
            let sb_x = chr.page_w - 11
            gui.rect(sb_x, chr.top_h, 11, chr.view_h, cp.sb_track[0], cp.sb_track[1], cp.sb_track[2], 210)
            let th = max([32, floor(chr.view_h * chr.view_h / lay.total_h)])
            let ms = max([1, lay.total_h - chr.view_h])
            let ty = chr.top_h + floor((chr.view_h - th) * sy / ms)
            gui.round_rect(sb_x + 2, ty + 2, 7, th - 4, 3.5, cp.sb_thumb[0], cp.sb_thumb[1], cp.sb_thumb[2], 230)

        gui.unclip()

        # 2. Optional Source / Inspector Drawer on right
        if show_source:
            let dx = chr.page_w
            let dw = w - dx
            gui.rect(dx, chr.top_h, dw, chr.view_h, cp.bar[0], cp.bar[1], cp.bar[2], 255)
            gui.line(dx, chr.top_h, dx, chr.top_h + chr.view_h, 1.0, cp.border[0], cp.border[1], cp.border[2], 255)
            gui.clip(dx, chr.top_h, dw, chr.view_h)
            var iy = chr.top_h + 12
            gui.text(dx + 14, iy, "THRUM BROWSER INSPECTOR", 12, cp.accent[0], cp.accent[1], cp.accent[2], "left", true)
            iy += 22
            gui.text(dx + 14, iy, "Status: HTTP {t.status}   Time: {t.load_ms} ms", 11.5, cp.txt[0], cp.txt[1], cp.txt[2], "left", false)
            iy += 18
            gui.text(dx + 14, iy, "DOM Nodes: {doc_nodes}   Words: {doc_words}   Links: {doc_links}", 11.5, cp.muted[0], cp.muted[1], cp.muted[2], "left", false)
            iy += 22
            gui.line(dx + 12, iy, w - 12, iy, 1.0, cp.border[0], cp.border[1], cp.border[2], 255)
            iy += 10
            gui.text(dx + 14, iy, "RAW HTML SOURCE", 11, cp.muted[0], cp.muted[1], cp.muted[2], "left", true)
            iy += 18
            let src_lines = text.lines(slice(t.raw_body, 0, min([3000, len(t.raw_body)])))
            for sl in src_lines:
                if iy > chr.top_h + chr.view_h - 14:
                    break
                var sline = trim(sl)
                if len(sline) > 48:
                    sline = slice(sline, 0, 46) + "…"
                if sline != "":
                    gui.text(dx + 14, iy, sline, 11, cp.txt[0], cp.txt[1], cp.txt[2], "left", false, 240, true)
                    iy += 15
            gui.unclip()

        # 3. Top Browser Chrome (Tab Strip + Navigation Toolbar + Bookmarks)
        gui.rect(0, 0, w, chr.top_h, cp.bar[0], cp.bar[1], cp.bar[2], 255)

        # Tabs
        let nt = len(tabs)
        let max_tw = min([200, floor((w - 60) / max([1, nt]))])
        for ti in 0..<nt:
            let tx = 8 + ti * (max_tw + 4)
            let is_act = ti == active_tab_idx
            var tbg = cp.tab_idle
            if is_act:
                tbg = cp.tab_active
            gui.round_rect(tx, 5, max_tw, chr.tab_h - 5, 7, tbg[0], tbg[1], tbg[2], 255)
            if is_act:
                gui.stroke_rect(tx, 5, max_tw, chr.tab_h - 5, 7, 1.0, cp.border[0], cp.border[1], cp.border[2], 255)
            var ttl = tabs[ti].title
            if len(ttl) > 20:
                ttl = slice(ttl, 0, 18) + "…"
            gui.text(tx + 10, 20, ttl, 11.5, cp.txt[0], cp.txt[1], cp.txt[2], "lmid", is_act)
            if nt > 1:
                gui.text(tx + max_tw - 14, 20, "×", 12, cp.muted[0], cp.muted[1], cp.muted[2], "mid", true)

        # New tab '+' button
        let plus_x = 12 + nt * (max_tw + 4)
        gui.round_rect(plus_x, 7, 26, 22, 6, cp.btn_bg[0], cp.btn_bg[1], cp.btn_bg[2], 255)
        gui.text(plus_x + 13, 18, "+", 14, cp.txt[0], cp.txt[1], cp.txt[2], "mid", true)

        # Toolbar row
        draw_chrome_btn(chr.back_btn, cp, len(t.history) > 0)
        draw_chrome_btn(chr.fwd_btn, cp, len(t.fwd) > 0)
        draw_chrome_btn(chr.rel_btn, cp, true)
        draw_chrome_btn(chr.home_btn, cp, true)
        draw_chrome_btn(chr.thm_btn, cp, true, dark_mode)
        draw_chrome_btn(chr.src_btn, cp, true, show_source)

        # URL bar
        let ub = chr.url_bar
        gui.round_rect(ub.x, ub.y, ub.w, ub.h, 8, cp.input_bg[0], cp.input_bg[1], cp.input_bg[2], 255)
        var ubd = cp.input_bd
        var ulw = 1.0
        if url_focused:
            ubd = cp.focus_bd
            ulw = 2.0
        gui.stroke_rect(ub.x, ub.y, ub.w, ub.h, 8, ulw, ubd[0], ubd[1], ubd[2], 255)
        gui.clip(ub.x + 8, ub.y, ub.w - 16, ub.h)
        var disp_url = url_input
        if url_focused:
            disp_url = url_input + "|"
        if disp_url == "":
            gui.text(ub.x + 10, ub.y + ub.h / 2, "Enter URL or search query (e.g. example.com)", 12.5, cp.muted[0], cp.muted[1], cp.muted[2], "lmid", false)
        else:
            gui.text(ub.x + 10, ub.y + ub.h / 2, disp_url, 12.5, cp.txt[0], cp.txt[1], cp.txt[2], "lmid", false)
        gui.unclip()

        # Bookmarks bar
        for bm in chr.bm_btns:
            var bg = cp.tab_idle
            if point_in(hover_x, hover_y, bm.x, bm.y, bm.w, bm.h):
                bg = cp.btn_hov
            gui.round_rect(bm.x, bm.y, bm.w, bm.h, 6, bg[0], bg[1], bg[2], 255)
            gui.text(bm.x + bm.w / 2, bm.y + bm.h / 2, bm.label, 11.5, cp.txt[0], cp.txt[1], cp.txt[2], "mid", false)

        gui.line(0, chr.top_h, w, chr.top_h, 1.0, cp.border[0], cp.border[1], cp.border[2], 255)

        # 4. Bottom Status Bar
        gui.rect(0, h - chr.bot_h, w, chr.bot_h, cp.bar[0], cp.bar[1], cp.bar[2], 255)
        gui.line(0, h - chr.bot_h, w, h - chr.bot_h, 1.0, cp.border[0], cp.border[1], cp.border[2], 255)
        var bot_left = status_text
        if hover_href != "":
            bot_left = hover_href
            if len(bot_left) > 90:
                bot_left = slice(bot_left, 0, 88) + "…"
        gui.text(12, h - chr.bot_h / 2, bot_left, 11, cp.muted[0], cp.muted[1], cp.muted[2], "lmid", false)
        gui.text(w - 12, h - chr.bot_h / 2, "Thrum Browser 0.2  •  {scroll_pct}% scrolled", 11, cp.muted[0], cp.muted[1], cp.muted[2], "rmid", false)

        gui.commit()

    # Open window and load initial page cleanly
    gui.open("Thrum Browser", 1120, 760)
    let init_sz = gui.size()
    view_h = max([120, init_sz.height - 132])
    open_new_tab(init_url)

    if shot_path != nil:
        let sz = gui.size()
        let chr = compute_chrome(sz.width, sz.height)
        view_h = chr.view_h
        if last_layout_w != sz.width:
            relayout_all(sz.width)
        render(chr)
        gui.screenshot(shot_path)
        let cur = tabs[active_tab_idx]
        io.say("Rendered '{cur.title}' ({cur.url}) status={cur.status} boxes={len(cur.layout.boxes)} links={cur.parsed.stats.links}")
        gui.close()
    else:
        var dirty = true
        while gui.is_open():
            let sz = gui.size()
            let chr = compute_chrome(sz.width, sz.height)
            view_h = chr.view_h
            if last_layout_w != sz.width:
                relayout_all(sz.width)
                dirty = true
            if dirty:
                render(chr)
                dirty = false

            gui.wait(40)
            let evs = gui.poll()
            for ev in evs:
                let ek = ev.kind
                if ek == "quit":
                    gui.close()
                    break
                elif ek == "resize":
                    relayout_all(ev.width)
                    dirty = true
                elif ek == "wheel":
                    if ev.x < chr.page_w and ev.y > chr.top_h and ev.y < chr.win_h - chr.bot_h:
                        set_scroll(tabs[active_tab_idx].scroll_y - ev.dy * 1.4)
                        dirty = true
                elif ek == "move":
                    hover_x = ev.x
                    hover_y = ev.y
                    var new_href = ""
                    if ev.x < chr.page_w - 12 and ev.y > chr.top_h and ev.y < chr.top_h + chr.view_h:
                        let py_doc = ev.y - chr.top_h + tabs[active_tab_idx].scroll_y
                        for lk in tabs[active_tab_idx].layout.links:
                            if point_in(ev.x, py_doc, lk.x, lk.y, lk.w, lk.h):
                                new_href = lk.href
                                break
                    if new_href != hover_href:
                        hover_href = new_href
                    dirty = true
                elif ek == "drag":
                    hover_x = ev.x
                    hover_y = ev.y
                    if dragging_scroll:
                        let tot = tabs[active_tab_idx].layout.total_h
                        if tot > chr.view_h:
                            let th = max([32, floor(chr.view_h * chr.view_h / tot)])
                            let span = max([1, chr.view_h - th])
                            let frac = clamp((ev.y - chr.top_h - drag_sb_off) / span, 0, 1)
                            set_scroll(frac * (tot - chr.view_h))
                            dirty = true
                elif ek == "up":
                    dragging_scroll = false
                elif ek == "down":
                    hover_x = ev.x
                    hover_y = ev.y
                    let px = ev.x
                    let py = ev.y

                    # Tab bar clicks
                    if py < chr.tab_h:
                        url_focused = false
                        let nt = len(tabs)
                        let max_tw = min([200, floor((chr.win_w - 60) / max([1, nt]))])
                        let plus_x = 12 + nt * (max_tw + 4)
                        if point_in(px, py, plus_x, 5, 28, chr.tab_h - 5):
                            open_new_tab("about:home")
                            dirty = true
                            continue
                        for ti in 0..<nt:
                            let tx = 8 + ti * (max_tw + 4)
                            if point_in(px, py, tx, 5, max_tw, chr.tab_h - 5):
                                if nt > 1 and px >= tx + max_tw - 24:
                                    var ntabs = []
                                    for j in 0..<nt:
                                        if j != ti:
                                            ntabs = push(ntabs, tabs[j])
                                    tabs = ntabs
                                    if active_tab_idx >= len(tabs):
                                        active_tab_idx = len(tabs) - 1
                                    url_input = tabs[active_tab_idx].url
                                    sync_reactive_from_tab()
                                else:
                                    active_tab_idx = ti
                                    url_input = tabs[ti].url
                                    sync_reactive_from_tab()
                                dirty = true
                                break
                        continue

                    # Toolbar button clicks
                    if point_in(px, py, chr.back_btn.x, chr.back_btn.y, chr.back_btn.w, chr.back_btn.h):
                        go_back()
                        dirty = true
                        continue
                    if point_in(px, py, chr.fwd_btn.x, chr.fwd_btn.y, chr.fwd_btn.w, chr.fwd_btn.h):
                        go_forward()
                        dirty = true
                        continue
                    if point_in(px, py, chr.rel_btn.x, chr.rel_btn.y, chr.rel_btn.w, chr.rel_btn.h):
                        navigate_tab(active_tab_idx, tabs[active_tab_idx].url, false)
                        dirty = true
                        continue
                    if point_in(px, py, chr.home_btn.x, chr.home_btn.y, chr.home_btn.w, chr.home_btn.h):
                        navigate_tab(active_tab_idx, "about:home", true)
                        dirty = true
                        continue
                    if point_in(px, py, chr.thm_btn.x, chr.thm_btn.y, chr.thm_btn.w, chr.thm_btn.h):
                        dark_mode = not dark_mode
                        relayout_all(chr.win_w)
                        dirty = true
                        continue
                    if point_in(px, py, chr.src_btn.x, chr.src_btn.y, chr.src_btn.w, chr.src_btn.h):
                        show_source = not show_source
                        relayout_all(chr.win_w)
                        dirty = true
                        continue
                    if point_in(px, py, chr.url_bar.x, chr.url_bar.y, chr.url_bar.w, chr.url_bar.h):
                        url_focused = true
                        dirty = true
                        continue
                    else:
                        url_focused = false

                    # Bookmark strip clicks
                    var hit_bm = false
                    for bm in chr.bm_btns:
                        if point_in(px, py, bm.x, bm.y, bm.w, bm.h):
                            navigate_tab(active_tab_idx, bm.url, true)
                            hit_bm = true
                            dirty = true
                            break
                    if hit_bm:
                        continue

                    # Scrollbar thumb click
                    if py > chr.top_h and py < chr.top_h + chr.view_h and px >= chr.page_w - 13 and px <= chr.page_w:
                        let tot = tabs[active_tab_idx].layout.total_h
                        if tot > chr.view_h:
                            dragging_scroll = true
                            drag_sb_off = 16
                        dirty = true
                        continue

                    # Clickable hyperlinks inside page viewport
                    if px < chr.page_w - 12 and py > chr.top_h and py < chr.top_h + chr.view_h:
                        let py_doc = py - chr.top_h + tabs[active_tab_idx].scroll_y
                        for lk in tabs[active_tab_idx].layout.links:
                            if point_in(px, py_doc, lk.x, lk.y, lk.w, lk.h):
                                navigate_tab(active_tab_idx, lk.href, true)
                                break
                        dirty = true
                elif ek == "key":
                    let k = ev.key
                    if ev.cmd and k == "l":
                        url_focused = true
                        dirty = true
                        continue
                    if ev.cmd and k == "r":
                        navigate_tab(active_tab_idx, tabs[active_tab_idx].url, false)
                        dirty = true
                        continue
                    if ev.cmd and k == "t":
                        open_new_tab("about:home")
                        url_focused = true
                        dirty = true
                        continue
                    if ev.cmd and k == "w":
                        if len(tabs) > 1:
                            var ntabs = []
                            for j in 0..<len(tabs):
                                if j != active_tab_idx:
                                    ntabs = push(ntabs, tabs[j])
                            tabs = ntabs
                            if active_tab_idx >= len(tabs):
                                active_tab_idx = len(tabs) - 1
                            url_input = tabs[active_tab_idx].url
                            sync_reactive_from_tab()
                            dirty = true
                        else:
                            gui.close()
                        continue
                    if url_focused:
                        if k == "enter":
                            url_focused = false
                            navigate_tab(active_tab_idx, url_input, true)
                        elif k == "esc":
                            url_input = tabs[active_tab_idx].url
                            url_focused = false
                        elif k == "backspace":
                            if ev.cmd:
                                url_input = ""
                            elif len(url_input) > 0:
                                url_input = slice(url_input, 0, len(url_input) - 1)
                        elif ev.cmd and k == "v":
                            url_input = url_input + trim(gui.clipboard())
                        elif ev.cmd and k == "c":
                            gui.set_clipboard(url_input)
                        elif k == "space":
                            url_input = url_input + " "
                        elif not ev.cmd and ev.text != "" and ev.text != "\r" and ev.text != "\n" and ev.text != "\t":
                            url_input = url_input + ev.text
                        dirty = true
                    else:
                        if k == "down":
                            set_scroll(tabs[active_tab_idx].scroll_y + 48)
                            dirty = true
                        elif k == "up":
                            set_scroll(tabs[active_tab_idx].scroll_y - 48)
                            dirty = true
                        elif k == "pagedown" or k == "space":
                            set_scroll(tabs[active_tab_idx].scroll_y + chr.view_h * 0.85)
                            dirty = true
                        elif k == "pageup":
                            set_scroll(tabs[active_tab_idx].scroll_y - chr.view_h * 0.85)
                            dirty = true
                        elif k == "home":
                            set_scroll(0)
                            dirty = true
                        elif k == "end":
                            set_scroll(tabs[active_tab_idx].layout.total_h)
                            dirty = true

with gui, net, clock, fs("."), args, io:
    run_browser_app(gui, net, clock, fs, args, io)

