with io:
    io.say(2.0 ± 0.1 m + 3.0 ± 0.2 m)
    io.say(5.0 ± 0.3 m - 2.0 ± 0.4 m)
    io.say((4.0 ± 0.2 m) * (2.0 ± 0.1 s))
    io.say((10.0 ± 0.5 m) / (2.0 ± 0.0 s))
    io.say((0 ± 0.1)^1)
    io.say(round(2 ^ 3.141592653589793, 6))
    io.say(10.0 ± 0.5 m ~ 10.8 m)
    io.say(10.0 ± 0.1 m ~ 15.0 m)
