var calls = 0
fn keyfn(x):
    calls += 1
    return -x
pin sorted_xs = sort([3, 1, 2], keyfn)
with io:
    io.say("{sorted_xs} calls={calls}")
    io.say(min(["pear", "apple", "fig"]))
    io.say(max(["pear", "apple", "fig"]))
    io.say(min([3 m, 100 cm, 2 m]))
    io.say(median([10, 2, 6, 4]))
    io.say(round(stdev([2, 4, 4, 4, 5, 5, 7, 9]), 3))
    io.say(uniq([1, 2, 1, 3, 2]))
    io.say(flatten([[1, 2], 3, [4]]))
    io.say(zip([1, 2], ["a", "b"]))
    io.say(enumerate(["x", "y"]))
    io.say(reduce([1, 2, 3, 4], fn(a, b): return a + b, 0))
    io.say(any([false, true]))
    io.say(all([2, 4, 6], \it % 2 == 0))
    io.say(find([1, 4, 7], \it > 3))
    io.say(count([1, 4, 7, 8], \it > 3))
    io.say(slice([10, 20, 30, 40], 1, 3))
    io.say(pop([1, 2, 3]))
    io.say(concat("hi ", "there"))
    io.say(reverse([1, 2, 3]))
