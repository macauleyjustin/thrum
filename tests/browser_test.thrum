# Pure-Thrum verification suite for Thrum Web Browser engine modules.
use test
use "../examples/browser/buf.thrum" as buf
use "../examples/browser/url.thrum" as url
use "../examples/browser/html.thrum" as html
use "../examples/browser/pages.thrum" as pages
use "../examples/browser/layout.thrum" as layout

fn t_buf():
    var b = buf.buf_new()
    for i in 0..<250:
        b = buf.buf_push(b, str(i))
    let xs = buf.buf_list(b)
    test.eq(len(xs), 250)
    test.eq(xs[0], "0")
    test.eq(xs[249], "249")
    test.eq(buf.buf_join(buf.buf_push(buf.buf_push(buf.buf_new(), "a"), "b"), "-"), "a-b")

fn t_url_parse_resolve():
    let p = url.parse_url("https://news.ycombinator.com:8443/item?id=42#top")
    test.eq(p.scheme, "https")
    test.eq(p.host, "news.ycombinator.com:8443")
    test.eq(p.path, "/item")
    test.eq(p.query, "id=42")
    test.eq(p.fragment, "top")
    test.eq(url.resolve_url("https://example.com/a/b/c.html", "../d.html?x=1"), "https://example.com/a/d.html?x=1")
    test.eq(url.resolve_url("https://example.com/p", "//cdn.example.com/lib.css"), "https://cdn.example.com/lib.css")
    test.eq(url.resolve_url("https://example.com/p", "/wiki/Compiler"), "https://example.com/wiki/Compiler")
    test.eq(url.resolve_url("about:home", "https://example.com"), "https://example.com")
    test.eq(url.normalize_input("thrum lang"), "https://lite.duckduckgo.com/lite/?q=thrum+lang")
    test.eq(url.normalize_input("example.com"), "https://example.com")
    test.eq(url.normalize_input("about:thrum"), "about:thrum")

fn t_html_parser():
    test.eq(html.decode_entities("A &amp; B &lt;3&#39;s &#x2014; &copy;"), "A & B <3's — ©")
    let raw = r"<!doctype html><html><head><title>Hi &amp; Bye</title><meta name=description content='Test desc'><style>body{color:red}</style><script>var x='<h1>no</h1>'</script></head><body><h1>Hello</h1><p>Read <a href='/docs'>the docs</a><li>One<li>Two</body></html>"
    let doc = html.parse_html(raw)
    test.eq(doc.title, "Hi & Bye")
    test.eq(doc.meta_desc, "Test desc")
    test.eq(len(doc.links), 1)
    test.eq(doc.links[0].href, "/docs")
    test.eq(doc.links[0].text, "the docs")
    test.ok(doc.stats.words >= 4)

fn t_pages():
    let home = pages.about_page("about:home")
    test.ok(home != nil)
    let hm_doc = html.parse_html(home)
    test.eq(hm_doc.title, "Thrum Browser — Start Page")
    test.ok(len(hm_doc.links) >= 6)
    test.eq(pages.escape_html("<a&b>"), "&lt;a&amp;b&gt;")
    let err_doc = html.parse_html(pages.error_page("https://bad.invalid", 502, "EOF"))
    test.eq(err_doc.title, "Cannot Load Page")

fn mock_measure(txt, sz, bold, mono):
    var factor = 0.52
    if mono:
        factor = 0.60
    elif bold:
        factor = 0.56
    return {width: len(txt) * sz * factor, height: sz * 1.25}

fn t_layout_engine():
    let raw = "<h1>Title</h1><p>Click <a href='/go'>here</a> now.</p><form><input type='hidden' value='SECRET_TOKEN'><input type='submit' value='Search'></form><table><tr><td>1.</td><td></td><td>Headline</td></tr><tr><td colspan='2'></td><td>Subtext line</td></tr></table>"
    let parsed = html.parse_html(raw)
    let lay = layout.layout_document(parsed.doc, 900, false, mock_measure, "https://example.com/", url.resolve_url)
    test.ok(lay.total_h > 100)
    test.eq(len(lay.links), 1)
    test.eq(lay.links[0].href, "https://example.com/go")
    var saw_secret = false
    var saw_search = false
    for bx in lay.boxes:
        if bx.kind == "text":
            if bx.txt == "SECRET_TOKEN":
                saw_secret = true
            if bx.txt == "Search":
                saw_search = true
    test.ok(not saw_secret)
    test.ok(saw_search)

test.run("browser buf O(N) chunker", t_buf)
test.run("browser url parser & resolver", t_url_parse_resolve)
test.run("browser html tokenizer & entities", t_html_parser)
test.run("browser built-in pages", t_pages)
test.run("browser layout, links & colspan tables", t_layout_engine)

let res = test.summary()
assert res.total == 5 and res.failed == 0, "browser tests had failures"
