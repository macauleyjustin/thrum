    ["copy-on-write reactivity", "var xs = [1, 2, 3]\nlet total = sum(xs)\nwith io:\n    io.say(total)\n    xs[0] = 10\n    io.say(total)\n", ["6", "15"]],
    ["capability required", "io.say(\"hi\")\n", ["undefined name 'io'"]],
    ["codata uncertainty", "use const\nwith io:\n    io.say(const.G)\n", ["6.6743", "±"]],
]

fn abs_path(p, cwd):
    if starts(p, "/"):
        return path.normalize(p)
    return path.normalize(path.join(cwd, p))

fn find_home(exe_p, cwd, fs_cap, env_cap):
    var cands = []
    let eh = env_cap.get("THRUM_HOME")
    if eh != "":
        cands = push(cands, abs_path(eh, cwd))
    let d1 = path.dirname(exe_p)
    if d1 != "":
        cands = push(cands, d1)
        let d2 = path.dirname(d1)
        if d2 != "":
            cands = push(cands, d2)
            let d3 = path.dirname(d2)
            if d3 != "":
                cands = push(cands, d3)
    cands = push(cands, cwd)
    for c in cands:
        let rt_h = path.join(c, "runtime", "thrum_rt.h")
        let std_d = path.join(c, "stdlib")
        if fs_cap.is_file(rt_h) and fs_cap.is_dir(std_d):
            return c
    fail("cannot locate Thrum runtime/ and stdlib/ directory (set THRUM_HOME)")

fn report_err(io_cap, e):
    if starts(e.message, "__THRUM_DIAG__\n"):
        io_cap.err(slice(e.message, 15))
    else:
        io_cap.err("thrumc: error: " + e.message)

fn emit_trimmed_err(io_cap, s):
    if not isnil(s) and s != "":
        var es = s
        if ends(es, "\n"):
            es = slice(es, 0, len(es) - 1)
        io_cap.err(es)

fn compile_src_to_c(src, af, disp_path, home, fs_cap, strict = false):
    let stdlib_dir = path.join(home, "stdlib")
    let checked = ck.check_program(src, af, stdlib_dir, fs_cap, disp_path, not strict)
    return cg.generate_c(checked, af, stdlib_dir)

fn compile_to_c(in_file, cwd, home, fs_cap, strict = false):
    let af = abs_path(in_file, cwd)
    if not fs_cap.is_file(af):
        fail("file not found: " + in_file)
    let src = fs_cap.read(af)
    return compile_src_to_c(src, af, in_file, home, fs_cap, strict)

fn detect_caps(c_code):
    let hdr = slice(c_code, 0, min([64, len(c_code)]))
    let has_hdr = starts(hdr, "/* THRUM_CAPS:")
    return {
        gui: has_hdr and (" gui " in hdr),
        net: has_hdr and (" net " in hdr),
    }

fn add_opt_backend(cmd_in, enabled, obj_nm, m_nm, stub_o_nm, stub_c_nm, fw, rt_dir, fs_cap):
    var cmd = cmd_in
    if enabled:
        let pre_o = path.join(rt_dir, "build", obj_nm)
        let alt_m = path.join(rt_dir, m_nm)
        if fs_cap.is_file(pre_o):
            cmd = push(cmd, pre_o)
        elif fs_cap.is_file(alt_m):
            cmd = push(cmd, alt_m)
        else:
            cmd = push(cmd, path.join(rt_dir, stub_c_nm))
        cmd = push(cmd, "-framework")
        cmd = push(cmd, fw)
    else:
        let stub_o = path.join(rt_dir, "build", stub_o_nm)
        if fs_cap.is_file(stub_o):
            cmd = push(cmd, stub_o)
        else:
            cmd = push(cmd, path.join(rt_dir, stub_c_nm))
    return cmd

fn compile_to_bin(c_path, out_bin, home, fs_cap, proc_cap, needs_gui = false, needs_net = false, extra_cflags = []):
    let rt_dir = path.join(home, "runtime")
    let lib_a = path.join(rt_dir, "libthrumrt.a")
    var cmd = ["cc", "-std=c11", "-O2", "-I" + rt_dir]
    for cf in extra_cflags:
        cmd = push(cmd, cf)
    cmd = push(cmd, c_path)
    if fs_cap.is_file(lib_a):
        cmd = push(cmd, lib_a)
    else:
        for f in RT_FILES:
            cmd = push(cmd, path.join(rt_dir, f))
    cmd = add_opt_backend(cmd, needs_gui, "rt_gui_cocoa.o", "rt_gui_cocoa.m", "rt_gui_stub.o", "rt_gui_stub.c", "Cocoa", rt_dir, fs_cap)
    cmd = add_opt_backend(cmd, needs_net, "rt_net_apple.o", "rt_net_apple.m", "rt_net_stub.o", "rt_net_stub.c", "Foundation", rt_dir, fs_cap)
    cmd = push(cmd, "-lm")
    cmd = push(cmd, "-o")
    cmd = push(cmd, out_bin)
    return proc_cap.run(cmd)

fn rstrip_spaces(s) -> text:
    var i = len(s)
    while i > 0:
        let c = s[i - 1]
        if c == " " or c == "\r":
            i -= 1
        else:
            break
    return slice(s, 0, i)

fn format_source_thrum(src, show_path) -> text:
    p.parse(src, show_path)
    var lines = split(replace(src, "\r\n", "\n"), "\n")
    while len(lines) > 0 and trim(lines[len(lines) - 1]) == "":
        lines = pop(lines)
    if len(lines) == 0:
        return ""
    var out = u.buf_new()
    var indent_stack = [0]
    for raw in lines:
        let stripped = text.ltrim(raw)
        if stripped == "":
            out = u.buf_push(out, "")
            continue
        let w = len(raw) - len(stripped)
        if starts(stripped, "#"):
            var level = len(indent_stack) - 1
            for idx in 0..<len(indent_stack):
                if w <= indent_stack[idx]:
                    level = idx
                    break
            out = u.buf_push(out, ("    " * level) + rstrip_spaces(stripped))
            continue
        if w > indent_stack[len(indent_stack) - 1]:
            indent_stack = push(indent_stack, w)
        else:
            while len(indent_stack) > 1 and w < indent_stack[len(indent_stack) - 1]:
                indent_stack = pop(indent_stack)
        let level = len(indent_stack) - 1
        out = u.buf_push(out, ("    " * level) + rstrip_spaces(stripped))
    return u.buf_join(out, "\n") + "\n"

fn ann_str(ann) -> text:
    if ann == nil:
        return ""
    if ann.kind == "kind":
        return ann.name
    if ann.kind == "dim":
        return ann.sym
    if ann.kind == "record":
        return ann.full
    if ann.kind == "list_of" or ann.kind == "map_of" or ann.kind == "union":
        return ann.disp
    return ""

fn extract_file_docs(src, title) -> text:
    let parsed = p.parse(src, title)
    let lines = parsed.info.lines
    var out = [title, "=" * len(title)]
    for st in parsed.body:
        if st.kind != "fndecl" and st.kind != "record" and st.kind != "decl":
            continue
        if st.site == nil:
            continue
        let ln = st.site.line - 1
        var dl = []
        var i = ln - 1
        while i >= 0 and starts(trim(lines[i]), "#"):
            var t = trim(lines[i])
            while starts(t, "#"):
                t = slice(t, 1)
            dl = push(dl, trim(t))
            i -= 1
        var rdl = []
        var j = len(dl) - 1
        while j >= 0:
            rdl = push(rdl, dl[j])
            j -= 1
        let doc = join(" ", rdl)
        var sig = ""
        if st.kind == "fndecl":
            var ps = []
            for prm in st.params:
                var item = prm.name
                let as_s = ann_str(prm.type)
                if as_s != "":
                    item = item + ": " + as_s
                if prm.default != nil:
                    item = item + " = ..."
                ps = push(ps, item)
            var ret = ""
            let rs = ann_str(st.ret)
            if rs != "":
                ret = " -> " + rs
            sig = "fn " + st.name + "(" + join(", ", ps) + ")" + ret
        elif st.kind == "record":
            var fs = []
            for fd in st.fields:
                var item = fd.name
                let as_s = ann_str(fd.type)
                if as_s != "":
                    item = item + ": " + as_s
                fs = push(fs, item)
            sig = "record " + st.name + r" { " + join(", ", fs) + r" }"
        else:
            sig = st.kw + " " + st.name + " = " + trim(st.src ?? "")
        out = push(out, "  " + sig)
        if doc != "":
            out = push(out, "      " + doc)
    return join("\n", out) + "\n"

fn collect_test_files(target_abs, fs_cap):
    if fs_cap.is_file(target_abs):
        return [target_abs]
    var out = []
    fn walk(dir_p):
        for entry in sort(fs_cap.list(dir_p)):
            let cp = path.join(dir_p, entry)
            if fs_cap.is_dir(cp):
                walk(cp)
            elif ends(entry, "_test.thrum"):
                out = push(out, cp)
    if fs_cap.is_dir(target_abs):
        walk(target_abs)
    return out

fn dump_ast_str(n, ind = 0) -> text:
    var out = u.buf_new()

    fn pad(k) -> text:
        return " " * k

    fn fmt_q_val(qv) -> text:
        if qv.disp != nil:
            let sc = qv.disp.sc
            if sc != 0.0:
                return "Q(" + str(qty(qv.v / sc, qv.disp.sym, qv.u / sc)) + ")"
        return "Q(" + str(with_unc(qv.v, qv.u)) + ")"

    fn fmt_py_str(s) -> text:
        var esc = replace(s, "\\", "\\\\")
        esc = replace(esc, "'", "\\'")
        esc = replace(esc, "\n", "\\n")
        esc = replace(esc, "\r", "\\r")
        esc = replace(esc, "\t", "\\t")
        return "'" + esc + "'"

    fn walk(v, d):
        let vt = type(v)
        if v == nil:
            out = u.buf_push(out, pad(d) + "None")
            return
        if vt == "bool":
            if v:
                out = u.buf_push(out, pad(d) + "True")
            else:
                out = u.buf_push(out, pad(d) + "False")
            return
        if vt == "text":
            out = u.buf_push(out, pad(d) + fmt_py_str(slice(v, 0, min([118, len(v)]))))
            return
        if vt == "list":
            for it in v:
                walk(it, d)
            return
        if vt == "map" and "kind" in v:
            out = u.buf_push(out, pad(d) + v.kind)
            if v.kind == "q":
                out = u.buf_push(out, pad(d + 2) + "value:")
                if v.lkind == "nil":
                    out = u.buf_push(out, pad(d + 4) + "None")
                elif v.lkind == "bool":
                    walk(v.val, d + 4)
                elif v.lkind == "str":
                    walk(v.val, d + 4)
                else:
                    out = u.buf_push(out, pad(d + 4) + fmt_q_val(v.val))
                return
            for kf in keys(v):
                if kf == "kind" or kf == "site":
                    continue
                out = u.buf_push(out, pad(d + 2) + kf + ":")
                walk(v[kf], d + 4)
            return
        let s = repr(v)
        out = u.buf_push(out, pad(d) + slice(s, 0, min([120, len(s)])))

    walk(n, ind)
    return u.buf_join(out, "\n")

fn run_compiled_src(src, af, disp_name, run_args, tmp_dir, home, fs_cap, proc_cap, clock_cap, strict = false, extra_cflags = []):
    let stem = ".thrumc_run_" + str(floor(bare(clock_cap.mono()) * 1000000))
    let tmp_c = path.join(tmp_dir, stem + ".c")
    let tmp_bin = path.join(tmp_dir, stem)
    try:
        let c_code = compile_src_to_c(src, af, disp_name, home, fs_cap, strict)
        let dc = detect_caps(c_code)
        fs_cap.write(tmp_c, c_code)
        let cr = compile_to_bin(tmp_c, tmp_bin, home, fs_cap, proc_cap, dc.gui, dc.net, extra_cflags)
        if fs_cap.exists(tmp_c):
            fs_cap.remove(tmp_c)
        if cr.code != 0:
            if fs_cap.exists(tmp_bin):
                fs_cap.remove(tmp_bin)
            return {ok: false, code: cr.code, out: "", err: cr.stderr ?? ""}
        let rr = proc_cap.run([tmp_bin] + run_args)
        if fs_cap.exists(tmp_bin):
            fs_cap.remove(tmp_bin)
        return {ok: rr.code == 0, code: rr.code, out: rr.stdout ?? "", err: rr.stderr ?? ""}
    catch e:
        if fs_cap.exists(tmp_c):
            try:
                fs_cap.remove(tmp_c)
            catch _e1:
                nil
        if fs_cap.exists(tmp_bin):
            try:
                fs_cap.remove(tmp_bin)
            catch _e2:
                nil
        var em = e.message
        if starts(em, "__THRUM_DIAG__\n"):
            em = slice(em, 15)
        return {ok: false, code: 1, out: "", err: em}

fn indent_block_lines(src_s) -> text:
    var out = []
    for ln in split(replace(src_s, "\r\n", "\n"), "\n"):
        if trim(ln) == "":
            out = push(out, "")
        else:
            out = push(out, "    " + ln)
    return join("\n", out)

fn run_repl(home, cwd, fs_cap, io_cap, env_cap, proc_cap, clock_cap):
    io_cap.say("Thrum " + VERSION + " — live relations, quantities, provenance. Type :help for commands, Ctrl-D to exit.")
    var tmp_dir = env_cap.get("TMPDIR")
    if tmp_dir == "":
        tmp_dir = cwd
    var decls = []
    while true:
        let line = io_cap.ask(">>> ")
        if line == "" and io_cap.eof():
            io_cap.say("")
            return
        var src_line = line
        let trimmed = trim(line)
        if trimmed == "":
            continue
        if starts(trimmed, ":"):
            let parts = text.words(trimmed)
            let cmd = parts[0]
            if cmd == ":q" or cmd == ":quit" or cmd == ":exit":
                return
            if cmd == ":help":
                io_cap.say("  :vars         list current top-level bindings")
                io_cap.say("  :why <name>   print dependency tree for <name>")
                io_cap.say("  :budget <n>   print uncertainty budget for <n>")
                io_cap.say("  :units [q]    search unit registry")
                io_cap.say("  :reset        clear all state")
                io_cap.say("  :quit         exit REPL")
                continue
            if cmd == ":reset":
                decls = []
                io_cap.say("(state cleared)")
                continue
            if cmd == ":units":
                var q = nil
                if len(parts) > 1:
                    q = parts[1]
                for sym in sort(uniq(units.list())):
                    if q == nil or (q in sym):
                        let v = qty(1, sym)
                        io_cap.say("  " + text.pad_right(sym, 12) + " " + text.pad_right(dim(v), 22) + " scale=" + fmt(bare(v)))
                continue
            if cmd == ":vars":
                let prog_s = join("\n", decls)
                if trim(prog_s) != "":
                    let r = run_compiled_src(prog_s, path.join(cwd, "<repl>"), "<repl>", [], tmp_dir, home, fs_cap, proc_cap, clock_cap, false, ["-DTHRUM_REPL_VARS=1"])
                    if r.out != "":
                        io_cap.print(r.out)
                    emit_trimmed_err(io_cap, r.err)
                continue
            if (cmd == ":why" or cmd == ":budget") and len(parts) == 2:
                src_line = slice(cmd, 1) + " " + parts[1]
            else:
                io_cap.say("unknown command " + repr(cmd) + " (try :help)")
                continue
        if ends(rstrip_spaces(src_line), ":"):
            var blk = [src_line]
            while true:
                let more = io_cap.ask("... ")
                if trim(more) == "" or (more == "" and io_cap.eof()):
                    break
                blk = push(blk, more)
            src_line = join("\n", blk)

        var parsed = nil
        try:
            parsed = p.parse(src_line, "<repl>")
        catch e:
            report_err(io_cap, e)
            continue
        if len(parsed.body) == 0:
            continue

        let prev_s = join("\n", decls)
        let sep = "__THRUM_REPL_MARK__"
        let is_expr_only = len(parsed.body) == 1 and parsed.body[0].kind == "exprstmt"
        var full_src = prev_s
        if full_src != "":
            full_src = full_src + "\n"
        var commit = false
        if is_expr_only:
            full_src = full_src + "with io:\n    io.say(\"" + sep + "\")\n    let _repl_val = (" + trim(src_line) + ")\n    if not isnil(_repl_val):\n        io.say(repr(_repl_val))\n"
        else:
            let sk = parsed.body[0].kind
            if len(parsed.body) == 1 and (sk == "decl" or sk == "fndecl" or sk == "record" or sk == "assign" or sk == "use" or sk == "settle" or sk == "live" or sk == "on"):
                commit = true
            full_src = full_src + "with io:\n    io.say(\"" + sep + "\")\n" + indent_block_lines(src_line) + "\n"

        let res = run_compiled_src(full_src, path.join(cwd, "<repl>"), "<repl>", [], tmp_dir, home, fs_cap, proc_cap, clock_cap, false)
        if not res.ok:
            emit_trimmed_err(io_cap, res.err)
            continue
        if commit:
            decls = push(decls, src_line)
        let mk_idx = text.index_of(res.out, sep + "\n")
        if mk_idx >= 0:
            let tail = slice(res.out, mk_idx + len(sep) + 1)
            if tail != "":
                io_cap.print(tail)

fn main():
    with io, args, env, fs("/"), proc, clock:
        let av = args.all()
        if len(av) == 0:
            io.say("usage: thrumc <build|emit-c|run|check|ast|graph|fmt|doc|units|test|repl|version> [file] [options]")
            proc.exit(0)
        let sub = av[0]
        if sub == "version":
            io.say("thrum " + VERSION)
            proc.exit(0)

        let cwd = proc.cwd()
        let home = find_home(proc.exe(), cwd, fs, env)
        let rest = av[1:]

        if sub == "repl":
            run_repl(home, cwd, fs, io, env, proc, clock)
            proc.exit(0)

        if sub == "units":
            var q = nil
            if len(rest) > 0:
                q = rest[0]
            let all_u = sort(uniq(units.list()))
            for sym in all_u:
                if q == nil or (q in sym):
                    let v = qty(1, sym)
                    let ds = dim(v)
                    let sc = bare(v)
                    io.say(text.pad_right(sym, 12) + " " + text.pad_right(ds, 22) + " scale=" + fmt(sc))
            proc.exit(0)

        if sub == "fmt":
            if len(rest) < 1:
                io.err("usage: thrumc fmt <file> [--write | --check]")
                proc.exit(1)
            let f = rest[0]
            let af = abs_path(f, cwd)
            var write_back = false
            var check_only = false
            for idx in 1..<len(rest):
                if rest[idx] == "--write" or rest[idx] == "-w":
                    write_back = true
                elif rest[idx] == "--check":
                    check_only = true
            try:
                if not fs.is_file(af):
                    io.err("file not found: " + f)
                    proc.exit(1)
                let src = fs.read(af)
                let formatted = format_source_thrum(src, f)
                if check_only:
                    if formatted != src:
                        io.err(f + ": would reformat")
                        proc.exit(1)
                    proc.exit(0)
                if write_back:
                    fs.write(af, formatted)
                else:
                    io.print(formatted)
                proc.exit(0)
            catch e:
                report_err(io, e)
                proc.exit(1)

        if sub == "doc":
            if len(rest) < 1:
                io.err("usage: thrumc doc <module|file>")
                proc.exit(1)
            let target = rest[0]
            if target in BUILTIN_DOC_EXPORTS:
                let title = "module " + target
                io.say(title)
                io.say("=" * len(title))
                for sym in BUILTIN_DOC_EXPORTS[target]:
                    io.say("  " + text.pad_right(sym, 18) + " <builtin " + target + "." + sym + ">")
                proc.exit(0)
            var file_t = target
            if starts(target, "std."):
                file_t = path.join(home, "stdlib", slice(target, 4) + ".thrum")
            else:
                file_t = abs_path(target, cwd)
            try:
                if not fs.is_file(file_t):
                    io.err("doc error: cannot find target '" + target + "'")
                    proc.exit(1)
                let src = fs.read(file_t)
                io.print(extract_file_docs(src, target))
                proc.exit(0)
            catch e:
                report_err(io, e)
                proc.exit(1)

        if sub == "test":
            var tmp_dir = env.get("TMPDIR")
            if tmp_dir == "":
                tmp_dir = cwd
            if len(rest) > 0:
                let tgt = abs_path(rest[0], cwd)
                let files = collect_test_files(tgt, fs)
                if len(files) == 0:
                    io.say("no *_test.thrum files found in " + rest[0])
                    proc.exit(1)
                var ok_cnt = 0
                for tf in files:
                    let src = fs.read(tf)
                    let res = run_compiled_src(src, tf, tf, [], tmp_dir, home, fs, proc, clock, false)
                    if res.ok:
                        io.say("  ok   " + tf)
                        ok_cnt += 1
                    else:
                        io.say("  FAIL " + tf)
                        emit_trimmed_err(io, res.err)
                io.say("\n" + str(ok_cnt) + "/" + str(len(files)) + " test files passed")
                if ok_cnt == len(files):
                    proc.exit(0)
                proc.exit(1)
            var passed = 0
            for tc in SELFTESTS:
                let nm = tc[0]
                let tsrc = tc[1]
                let expects = tc[2]
                let sf = path.join(tmp_dir, ".thrumc_st.thrum")
                let res = run_compiled_src(tsrc, sf, "<test>", [], tmp_dir, home, fs, proc, clock, false)
                let got = res.out + res.err
                var match_ok = true
                for ex in expects:
                    if not (ex in got):
                        match_ok = false
                if match_ok:
                    io.say("  ok   " + nm)
                    passed += 1
                else:
                    io.say("  FAIL " + nm + "\n       got " + repr(got))
            io.say("\n" + str(passed) + "/" + str(len(SELFTESTS)) + " passed")
            if passed == len(SELFTESTS):
                proc.exit(0)
            proc.exit(1)

        if sub == "check":
            if len(rest) < 1:
                io.err("usage: thrumc check <file>")
                proc.exit(1)
            let f = rest[0]
            let af = abs_path(f, cwd)
            try:
                if not fs.is_file(af):
                    io.err("file not found: " + f)
                    proc.exit(1)
                let src = fs.read(af)
                ck.check_program(src, af, path.join(home, "stdlib"), fs, f)
                io.say(f + ": ok")
                proc.exit(0)
            catch e:
                report_err(io, e)
                proc.exit(1)

        if sub == "emit-c":
            if len(rest) < 1:
                io.err("usage: thrumc emit-c <file> [-o out.c] [--strict]")
                proc.exit(1)
            let f = rest[0]
            var out_c = path.stem(f) + ".c"
            var strict = false
            var i = 1
            while i < len(rest):
                if rest[i] == "-o" and i + 1 < len(rest):
                    out_c = rest[i + 1]
                    i += 2
                elif rest[i] == "--strict":
                    strict = true
                    i += 1
                else:
                    i += 1
            try:
                let c_code = compile_to_c(f, cwd, home, fs, strict)
                if out_c == "-":
                    io.print(c_code)
                else:
                    fs.write(abs_path(out_c, cwd), c_code)
                proc.exit(0)
            catch e:
                report_err(io, e)
                proc.exit(1)

        if sub == "build":
            if len(rest) < 1:
                io.err("usage: thrumc build <file> [-o out] [--keep-c] [--strict]")
                proc.exit(1)
            let f = rest[0]
            var out_bin = path.stem(f)
            var keep_c = false
            var strict = false
            var i = 1
            while i < len(rest):
                if rest[i] == "-o" and i + 1 < len(rest):
                    out_bin = rest[i + 1]
                    i += 2
                elif rest[i] == "--keep-c":
                    keep_c = true
                    i += 1
                elif rest[i] == "--strict":
                    strict = true
                    i += 1
                else:
                    i += 1
            let out_abs = abs_path(out_bin, cwd)
            let tmp_c = out_abs + ".thrumc.c"
            try:
                let c_code = compile_to_c(f, cwd, home, fs, strict)
                let dc = detect_caps(c_code)
                fs.write(tmp_c, c_code)
                let cr = compile_to_bin(tmp_c, out_abs, home, fs, proc, dc.gui, dc.net)
                if not keep_c and fs.exists(tmp_c):
                    fs.remove(tmp_c)
                if cr.code != 0:
                    emit_trimmed_err(io, cr.stderr)
                    proc.exit(cr.code)
                proc.exit(0)
            catch e:
                if fs.exists(tmp_c):
                    try:
                        fs.remove(tmp_c)
                    catch _e:
                        nil
                report_err(io, e)
                proc.exit(1)

        if sub == "ast":
            if len(rest) < 1:
                io.err("usage: thrumc ast <file>")
                proc.exit(1)
            let f = rest[0]
            let af = abs_path(f, cwd)
            try:
                if not fs.is_file(af):
                    io.err("file not found: " + f)
                    proc.exit(1)
                let src = fs.read(af)
                let parsed = p.parse(src, f)
                for st in parsed.body:
                    let s = dump_ast_str(st, 0)
                    if s != "":
                        io.say(s)
                proc.exit(0)
            catch e:
                report_err(io, e)
                proc.exit(1)

        if sub == "graph":
            if len(rest) < 1:
                io.err("usage: thrumc graph <file> [symbol] [--format dot|mermaid]")
                proc.exit(1)
            let f = rest[0]
            var g_sym = ""
            var g_fmt = "dot"
            var i = 1
            while i < len(rest):
                if rest[i] == "--format" and i + 1 < len(rest):
                    g_fmt = rest[i + 1]
                    i += 2
                else:
                    if g_sym == "":
                        g_sym = rest[i]
                    i += 1
            if g_fmt != "dot" and g_fmt != "mermaid":
                io.err("thrumc graph: --format must be 'dot' or 'mermaid'")
                proc.exit(1)
            var tmp_dir = env.get("TMPDIR")
            if tmp_dir == "":
                tmp_dir = path.dirname(abs_path(f, cwd))
                if tmp_dir == "":
                    tmp_dir = cwd
            let af = abs_path(f, cwd)
            if not fs.is_file(af):
                io.err("thrumc: error: file not found: " + f)
                proc.exit(1)
            let src = fs.read(af)
            let cfl = ["-DTHRUM_GRAPH_FMT=" + cg.c_str_lit(g_fmt), "-DTHRUM_GRAPH_SYM=" + cg.c_str_lit(g_sym)]
            let res = run_compiled_src(src, af, f, [], tmp_dir, home, fs, proc, clock, false, cfl)
            if res.out != "":
                io.print(res.out)
            emit_trimmed_err(io, res.err)
            proc.exit(res.code)

        if sub == "run":
            if len(rest) < 1:
                io.err("usage: thrumc run <file> [--strict] [-- args...]")
                proc.exit(1)
            let f = rest[0]
            var strict = false
            var run_args = []
            var seen_dash = false
            for a in rest[1:]:
                if a == "--" and not seen_dash:
                    seen_dash = true
                    run_args = push(run_args, a)
                elif not seen_dash and a == "--strict":
                    strict = true
                else:
                    run_args = push(run_args, a)
            var tmp_dir = env.get("TMPDIR")
            if tmp_dir == "":
                tmp_dir = path.dirname(abs_path(f, cwd))
                if tmp_dir == "":
                    tmp_dir = cwd
            let af = abs_path(f, cwd)
            if not fs.is_file(af):
                io.err("thrumc: error: file not found: " + f)
                proc.exit(1)
            let src = fs.read(af)
            let res = run_compiled_src(src, af, f, run_args, tmp_dir, home, fs, proc, clock, strict)
            if res.out != "":
                io.print(res.out)
            emit_trimmed_err(io, res.err)
            proc.exit(res.code)

        io.err("unknown subcommand '" + sub + "'")
        proc.exit(1)

main()
