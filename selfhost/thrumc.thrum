    ["whatif", "var m = 72 kg\nvar h = 1.8 m\nlet bmi = m / h^2\nwith io:\n    whatif m = 90 kg:\n        io.say(round(bmi, 2))\n    io.say(round(bmi, 2))\n", ["27.78", "22.22"]],
